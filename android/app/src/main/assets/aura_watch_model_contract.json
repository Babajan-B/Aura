    "gyro_magnitude_std",
    "gyro_magnitude_max",
    "heart_rate_mean",
    "heart_rate_std",
    "heart_rate_min",
    "heart_rate_max",
    "temperature_mean_c",
    "temperature_std_c",
    "battery_fraction",
    "accel_completeness",
    "gyro_available",
